---
import { Picture, getImage } from 'astro:assets';
import { modes as everyMode, type Mode, type PromoCode } from '../codes';
import en from '../i18n/en.json';
import fr from '../i18n/fr.json';

interface Props {
  item: PromoCode;
  eager?: boolean;
  locale: 'en' | 'fr';
}

const { item, eager = false, locale } = Astro.props;
const t = locale === 'fr' ? fr : en;
const dateFmt = locale === 'fr' ? 'fr-FR' : 'en-GB';
const working = item.status === 'working';
const allModes = everyMode.every((m) => item.modes.includes(m));
const single = item.modes.length === 1;
const fmtDate = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString(dateFmt, {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
const addedLabel = item.added ? fmtDate(item.added) : null;
const expiredLabel = item.expired ? fmtDate(item.expired) : null;
const reward = item.reward;
const note = item.noteKey ? t.codeNotes[item.noteKey as keyof typeof t.codeNotes] : null;
const modeTitle = t.modeTitles as Record<Mode, string>;
const modeLabel = t.modes as Record<Mode, string>;
// Never ask for a size bigger than the screenshot itself.
const widths = reward ? [...[400, 760].filter((w) => w < reward.width), reward.width] : [];
// Full-size copy for the click-to-enlarge view.
const full = reward ? await getImage({ src: reward, format: 'webp' }) : null;
---

<li class:list={['card', { dead: !working }]} id={item.code} data-modes={item.modes.join(' ')} data-added={item.added}>
  {
    reward && full ? (
      <button
        class="shot"
        type="button"
        data-full={full.src}
        data-w={reward.width}
        data-h={reward.height}
        aria-label={`${t.enlargeRewards} ${item.code}`}>
        <Picture
          src={reward}
          formats={['avif', 'webp']}
          widths={widths}
          sizes="(max-width: 700px) calc(100vw - 54px), 360px"
          alt={`${t.rewards} ${item.code}`}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
        />
      </button>
    ) : (
      <div class="shot empty">{working ? t.noScreenshotYet : t.noScreenshot}</div>
    )
  }

  <button
    class="code"
    type="button"
    data-code={item.code}
    data-copy-label={t.copy}
    data-copied-label={t.copied}
    aria-label={`${t.copyAria} ${item.code}`}
  >
    <span class="code-text">{item.code}</span>
    <span class="copy" aria-hidden="true">
      <svg class="i-copy" viewBox="0 0 24 24" width="16" height="16"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
      <svg class="i-check" viewBox="0 0 24 24" width="16" height="16"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
      <span class="copy-label">{t.copy}</span>
    </span>
  </button>

  <div class="meta">
    <span class="modes">
      {
        allModes ? (
          <span class="mode all" title={t.allModesTitle} data-mode="all">
            {t.allModes}
          </span>
        ) : (
          item.modes.map((m) => (
            <span class={`mode ${m}`} title={single ? `${modeTitle[m]} ${t.only}` : modeTitle[m]} data-mode={m}>
              {modeLabel[m]}
              {single && <span class="only">{t.only}</span>}
            </span>
          ))
        )
      }
    </span>
    <span class="tags">
      {working && <span class="tag new" hidden data-i18n="new">{t.new}</span>}
      <span class:list={['tag', working ? 'ok' : 'bad']} data-status={working ? 'working' : 'expired'}>{working ? t.working : t.expiredStatus}</span>
    </span>
  </div>

  {(note || addedLabel || expiredLabel || working) && (
    <div class="info">
      {note && <span class="note" data-note-key={item.noteKey}>{note}</span>}
      {addedLabel && <time datetime={item.added} data-added={item.added}>{t.added} {addedLabel}</time>}
      {expiredLabel && <time datetime={item.expired} data-expired={item.expired}>{t.expiredStatus} {expiredLabel}</time>}
      {working && (
        <button
          type="button"
          class="redeem-toggle"
          aria-pressed="false"
          title={t.redeemedTitle}
          data-i18n-title="redeemedTitle">
          <span class="box" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
          </span>
          <span data-i18n="redeemed">{t.redeemed}</span>
        </button>
      )}
    </div>
  )}
</li>
