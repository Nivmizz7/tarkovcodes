---
import { Picture, getImage } from 'astro:assets';
import { modes as everyMode, type Mode, type PromoCode } from '../codes';
import en from '../i18n/en.json';

interface Props {
  item: PromoCode;
  eager?: boolean;
}

const { item, eager = false } = Astro.props;
const working = item.status === 'working';
const allModes = everyMode.every((m) => item.modes.includes(m));
const single = item.modes.length === 1;
const addedLabel = item.added
  ? new Date(item.added + 'T00:00:00Z').toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : null;
const reward = item.reward;
const note = item.noteKey ? en.codeNotes[item.noteKey as keyof typeof en.codeNotes] : null;
const modeTitle = en.modeTitles as Record<Mode, string>;
const modeLabel = en.modes as Record<Mode, string>;
// Never ask for a size bigger than the screenshot itself.
const widths = reward ? [...[400, 760].filter((w) => w < reward.width), reward.width] : [];
// Full-size copy for the click-to-enlarge view.
const full = reward ? await getImage({ src: reward, format: 'webp' }) : null;
---

<li class:list={['card', { dead: !working }]} data-modes={item.modes.join(' ')}>
  {
    reward && full ? (
      <button
        class="shot"
        type="button"
        data-full={full.src}
        data-w={reward.width}
        data-h={reward.height}
        aria-label={`${en.enlargeRewards} ${item.code}`}>
        <Picture
          src={reward}
          formats={['avif', 'webp']}
          widths={widths}
          sizes="(max-width: 700px) calc(100vw - 54px), 360px"
          alt={`${en.rewards} ${item.code}`}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
        />
      </button>
    ) : (
      <div class="shot empty">{working ? en.noScreenshotYet : en.noScreenshot}</div>
    )
  }

  <button
    class="code"
    type="button"
    data-code={item.code}
    data-copy-label={en.copy}
    data-copied-label={en.copied}
    aria-label={`${en.copyAria} ${item.code}`}
  >
    <span class="code-text">{item.code}</span>
    <span class="copy" aria-hidden="true">
      <svg class="i-copy" viewBox="0 0 24 24" width="16" height="16"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
      <svg class="i-check" viewBox="0 0 24 24" width="16" height="16"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
      <span class="copy-label">{en.copy}</span>
    </span>
  </button>

  <div class="meta">
    <span class="modes">
      {
        allModes ? (
          <span class="mode all" title={en.allModesTitle} data-mode="all">
            {en.allModes}
          </span>
        ) : (
          item.modes.map((m) => (
            <span class={`mode ${m}`} title={single ? `${modeTitle[m]} ${en.only}` : modeTitle[m]} data-mode={m}>
              {modeLabel[m]}
              {single && <span class="only">{en.only}</span>}
            </span>
          ))
        )
      }
    </span>
    <span class:list={['tag', working ? 'ok' : 'bad']} data-status={working ? 'working' : 'expired'}>{working ? en.working : en.expiredStatus}</span>
  </div>

  {(note || addedLabel) && (
    <p class="info">
      {note && <span class="note" data-note-key={item.noteKey}>{note}</span>}
      {addedLabel && <time datetime={item.added} data-added={item.added}>{en.added} {addedLabel}</time>}
    </p>
  )}
</li>
