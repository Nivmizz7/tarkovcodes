---
import '@fontsource/saira-semi-condensed/latin-400.css';
import '@fontsource/saira-semi-condensed/latin-700.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import CodeCard from '../components/CodeCard.astro';
import { codes, modes, updated } from '../codes';
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import contributors from '../i18n/contributors.json';
import type { Mode } from '../codes';

const modeLabel = en.modes as Record<Mode, string>;

const updatedLabel = new Date(updated + 'T00:00:00Z').toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const repo = 'https://github.com/Wilsman/tarkovcodes';
const siteUrl = new URL('/', Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const description = en.meta.description;

// Newest first; codes without a date go last.
const sorted = [...codes].sort((a, b) => (b.added ?? '').localeCompare(a.added ?? ''));
const working = sorted.filter((c) => c.status === 'working');
const expired = sorted.filter((c) => c.status === 'expired');
// Picker counts are for working codes, since that's what the main grid shows.
const counts = Object.fromEntries(modes.map((m) => [m, working.filter((c) => c.modes.includes(m)).length]));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#131414" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{en.meta.title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />

    <!-- Link preview: the in-game "Code activation" dialog with the site URL typed in -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={en.brand} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={en.meta.title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={en.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={en.meta.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header class="topbar">
      <div class="bar-inner">
        <a class="brand" href="/">{en.brand}</a>
        <div class="language-picker" role="group" aria-label="Langue / Language">
          <button type="button" class="locale" data-locale="fr" aria-label="Français" title="Français">
            <img src="/flags/fr.svg" alt="" width="24" height="16" />
          </button>
          <button type="button" class="locale active" data-locale="en" aria-label="English" title="English">
            <img src="/flags/en.svg" alt="" width="24" height="16" />
          </button>
        </div>
        <a class="suggest" href={`${repo}/issues/new/choose`} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          {en.suggestCode}
        </a>
      </div>
    </header>

    <main>
      <div class="hero">
        <div>
          <p class="kicker" data-updated-label={updatedLabel}><span class="sq"></span>{en.updated} {updatedLabel}</p>
          <h1>{en.heading}</h1>
          <p class="sub">{en.subtitle}</p>
        </div>
        <fieldset class="picker" hidden>
          <legend>{en.play}</legend>
          <div class="seg">
            <label class="opt all" title={en.showAllTitle}>
              <input type="radio" name="mode" value="all" checked />
              <span><span class="dot" aria-hidden="true"></span>{en.all} <span class="n">{working.length}</span></span>
            </label>
            {
              modes.map((m) => (
                <label class={`opt ${m}`} title={`${en.working} in ${modeLabel[m]}`}>
                  <input type="radio" name="mode" value={m} />
                  <span>
                    <span class="dot" aria-hidden="true"></span>
                    {modeLabel[m]} <span class="n">{counts[m]}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
      </div>

      <ol class="steps" aria-label={en.redeemAria}>
        <li><span class="num">1</span>{en.redeem[0]}</li>
        <li><span class="num">2</span>{en.redeem[1]} <span class="arr">&rarr;</span> {en.redeem[2]} <span class="arr">&rarr;</span> <b>{en.redeem[3]}</b></li>
        <li><span class="num">3</span>{en.redeem[4]}</li>
      </ol>

      <ul class="grid">
        {working.map((item, i) => <CodeCard item={item} eager={i < 3} />)}
      </ul>
      <p class="empty-msg" hidden>{en.empty}</p>

      {
        expired.length > 0 && (
          <details class="expired">
            <summary>
              <span class="exp-title">{en.expired}</span>
              <span class="exp-n">{expired.length}</span>
              <span class="exp-hint">
                <span class="show">{en.show}</span>
                <span class="hide">{en.hide}</span>
              </span>
            </summary>
            <p class="exp-sub">{en.expiredSubtitle}</p>
            <ul class="grid">
              {expired.map((item) => (
                <CodeCard item={item} />
              ))}
            </ul>
          </details>
        )
      }

      <footer>
        <p>
          <span class="footer-new-code">{en.footerNewCode}</span>
          <a class="tell-us" href={`${repo}/issues/new/choose`} target="_blank" rel="noopener">{en.tellUs}</a>. <span class="site-is">{en.siteIs}</span>
          <a class="open-source" href={repo} target="_blank" rel="noopener">{en.openSource}</a>.
        </p>
        <p>{en.disclaimer}</p>
        <div class="contributors-footer">
          <a class="repo-link" href={repo} target="_blank" rel="noopener" aria-label="GitHub repository">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.69c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.96c.85 0 1.71.11 2.51.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.62c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path>
            </svg>
            GitHub
          </a>
          <span class="contributors-label">{en.contributors}</span>
          <div class="contributors">
            {contributors.map((contributor) => (
              <a
                href={contributor.html_url}
                target="_blank"
                rel="noopener"
                title={`${contributor.login} — ${contributor.contributions} contributions`}
              >
                <img
                  src={contributor.avatar_url}
                  alt={contributor.login}
                  width="34"
                  height="34"
                  loading="lazy"
                />
              </a>
            ))}
          </div>
        </div>
      </footer>
    </main>

    <dialog class="viewer" aria-label={en.viewerAria}></dialog>
    <div class="toast" role="status" aria-live="polite" data-copied-toast={en.copiedToast} data-copy-failed={en.copyFailed}></div>

    <script is:inline define:vars={{ locales: { fr, en } }}>
      (() => {
        const localeButtons = document.querySelectorAll('[data-locale]');
        const applyLocale = (locale) => {
          const t = locales[locale] || locales.fr;
          document.documentElement.lang = locale;
          document.title = t.meta.title;
          document.querySelector('meta[name="description"]')?.setAttribute('content', t.meta.description);
          document.querySelector('meta[property="og:title"]')?.setAttribute('content', t.meta.title);
          document.querySelector('meta[property="og:description"]')?.setAttribute('content', t.meta.description);
          document.querySelector('meta[property="og:image:alt"]')?.setAttribute('content', t.meta.ogImageAlt);
          document.querySelector('meta[name="twitter:title"]')?.setAttribute('content', t.meta.title);
          document.querySelector('meta[name="twitter:description"]')?.setAttribute('content', t.meta.description);

          document.querySelector('.suggest').lastChild.textContent = ' ' + t.suggestCode;
          document.querySelector('.brand').textContent = t.brand;
          const kicker = document.querySelector('.kicker');
          kicker.lastChild.textContent = t.updated + ' ' + kicker.dataset.updatedLabel;
          document.querySelector('h1').textContent = t.heading;
          document.querySelector('.sub').textContent = t.subtitle;
          document.querySelector('.picker legend').textContent = t.play;
          document.querySelector('.opt.all').title = t.showAllTitle;
          document.querySelector('.opt.all > span').firstChild.nextSibling.textContent = t.all + ' ';
          document.querySelector('.steps').setAttribute('aria-label', t.redeemAria);
          document.querySelectorAll('.steps li').forEach((li, i) => {
            if (i === 0) li.lastChild.textContent = t.redeem[0];
            if (i === 1) {
              li.childNodes[1].textContent = t.redeem[1] + ' ';
              li.childNodes[3].textContent = ' ' + t.redeem[2] + ' ';
              li.querySelector('b').textContent = t.redeem[3];
            }
            if (i === 2) li.lastChild.textContent = t.redeem[4];
          });
          document.querySelector('.empty-msg').textContent = t.empty;
          document.querySelector('.exp-title')?.replaceChildren(t.expired);
          document.querySelector('.exp-sub')?.replaceChildren(t.expiredSubtitle);
          document.querySelector('.show')?.replaceChildren(t.show);
          document.querySelector('.hide')?.replaceChildren(t.hide);
          document.querySelector('.contributors-label').textContent = t.contributors;
          document.querySelector('.footer-new-code').textContent = t.footerNewCode;
          document.querySelector('.tell-us').textContent = t.tellUs;
          document.querySelector('.open-source').textContent = t.openSource;
          document.querySelector('.site-is').textContent = t.siteIs;
          document.querySelector('footer > p:last-of-type').textContent = t.disclaimer;
          document.querySelector('.viewer').setAttribute('aria-label', t.viewerAria);

          document.querySelectorAll('.mode.all').forEach((el) => {
            el.title = t.allModesTitle;
            el.textContent = t.allModes;
          });
          document.querySelectorAll('.mode[data-mode]').forEach((el) => {
            const mode = el.dataset.mode;
            el.title = el.querySelector('.only') ? t.modeTitles[mode] + ' — ' + t.only : t.modeTitles[mode];
          });
          document.querySelectorAll('[data-status]').forEach((el) => {
            el.textContent = el.dataset.status === 'working' ? t.working : t.expiredStatus;
          });
          document.querySelectorAll('.copy-label').forEach((el) => {
            el.textContent = el.closest('.code')?.classList.contains('copied') ? t.copied : t.copy;
          });
          document.querySelectorAll('.code').forEach((el) => {
            el.dataset.copyLabel = t.copy;
            el.dataset.copiedLabel = t.copied;
            el.setAttribute('aria-label', t.copyAria + ' ' + el.dataset.code);
          });
          document.querySelectorAll('.shot').forEach((el) => {
            el.setAttribute('aria-label', t.enlargeRewards + ' ' + el.closest('li').querySelector('[data-code]').dataset.code);
            const img = el.querySelector('img');
            if (img) img.alt = t.rewards + ' ' + el.closest('li').querySelector('[data-code]').dataset.code;
          });
          document.querySelectorAll('.shot.empty').forEach((el) => {
            el.textContent = el.closest('li').classList.contains('dead') ? t.noScreenshot : t.noScreenshotYet;
          });
          document.querySelectorAll('[data-note-key]').forEach((el) => {
            el.textContent = t.codeNotes[el.dataset.noteKey];
          });
          document.querySelectorAll('time[data-added]').forEach((el) => {
            el.textContent = t.added + ' ' + new Date(el.dataset.added + 'T00:00:00Z').toLocaleDateString(
              locale === 'fr' ? 'fr-FR' : 'en-GB',
              { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' },
            );
          });

          const toast = document.querySelector('.toast');
          toast.dataset.copiedToast = t.copiedToast;
          toast.dataset.copyFailed = t.copyFailed;
          localeButtons.forEach((button) => button.classList.toggle('active', button.dataset.locale === locale));
          try { localStorage.setItem('tc-language', locale); } catch {}
        };

        let initialLocale = 'en';
        try { initialLocale = localStorage.getItem('tc-language') || 'en'; } catch {}
        localeButtons.forEach((button) => button.addEventListener('click', () => applyLocale(button.dataset.locale)));
        applyLocale(initialLocale);

        // Copy to clipboard
        const toast = document.querySelector('.toast');
        let t;
        const copy = async (text) => {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.cssText = 'position:fixed;opacity:0';
            document.body.appendChild(ta);
            ta.select();
            const ok = document.execCommand('copy');
            ta.remove();
            return ok;
          }
        };

        // Click-to-enlarge screenshots
        // A fresh <img> per open, so the previous screenshot never shows. It starts
        // with the card's already-loaded copy and swaps to full size once decoded.
        const viewer = document.querySelector('.viewer');
        viewer.addEventListener('click', () => viewer.close());
        viewer.addEventListener('close', () => viewer.replaceChildren());

        document.addEventListener('click', async (e) => {
          const shot = e.target.closest('[data-full]');
          if (shot) {
            const thumb = shot.querySelector('img');
            const img = new Image();
            img.alt = thumb?.alt || '';
            const w = Number(shot.dataset.w);
            const h = Number(shot.dataset.h);
            img.width = w;
            img.height = h;
            // Final size up front, so the swap to full size doesn't resize it.
            img.style.width = `min(${w}px, 96vw - 2px, 1098px, (92vh - 2px) * ${w / h})`;
            img.src = thumb?.currentSrc || shot.dataset.full;
            viewer.replaceChildren(img);
            viewer.showModal();
            const full = new Image();
            full.src = shot.dataset.full;
            full
              .decode()
              .then(() => {
                if (img.isConnected) img.src = full.src;
              })
              .catch(() => {});
            return;
          }
          const btn = e.target.closest('[data-code]');
          if (!btn) return;
          const code = btn.dataset.code;
          const ok = await copy(code);
          btn.classList.toggle('copied', ok);
          btn.querySelector('.copy-label').textContent = ok ? btn.dataset.copiedLabel : btn.dataset.copyLabel;
          clearTimeout(btn._t);
          btn._t = setTimeout(() => {
            btn.classList.remove('copied');
            btn.querySelector('.copy-label').textContent = btn.dataset.copyLabel;
          }, 1600);
          toast.textContent = ok ? code + ' ' + toast.dataset.copiedToast : toast.dataset.copyFailed;
          toast.classList.add('show');
          clearTimeout(t);
          t = setTimeout(() => toast.classList.remove('show'), 1600);
        });

        // "I play" picker: show the codes that work in the chosen mode
        const KEY = 'tc-mode';
        const picker = document.querySelector('.picker');
        const cards = [...document.querySelectorAll('.grid > li')];
        const emptyMsg = document.querySelector('.empty-msg');
        const expiredN = document.querySelector('.exp-n');
        const apply = (mode) => {
          let live = 0;
          let dead = 0;
          for (const card of cards) {
            const show = mode === 'all' || card.dataset.modes.split(' ').includes(mode);
            card.hidden = !show;
            if (show) card.classList.contains('dead') ? dead++ : live++;
          }
          emptyMsg.hidden = live > 0;
          if (expiredN) expiredN.textContent = String(dead);
        };
        let saved = 'all';
        try {
          saved = localStorage.getItem(KEY) || 'all';
          localStorage.removeItem('tc-modes'); // old toggle setting
        } catch {}
        const input = picker.querySelector(`input[value="${CSS.escape(saved)}"]`) || picker.querySelector('input');
        input.checked = true;
        picker.addEventListener('change', (e) => {
          apply(e.target.value);
          try {
            localStorage.setItem(KEY, e.target.value);
          } catch {}
        });
        picker.hidden = false;
        apply(input.value);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #131414;
    --panel: #1b1c1c;
    --panel-2: #171818;
    --line: #2b2e2e;
    --line-hi: #3a3e3e;
    --text: #c2cdcd;
    --bright: #e7eded;
    --muted: #7f8989;
    --teal: #6fd5b4;
    --stash: #3d5559;
    --ok: #93cf86;
    --ok-bg: rgba(147, 207, 134, 0.1);
    --bad: #e2685a;
    --bad-bg: rgba(226, 104, 90, 0.1);
    --metal: linear-gradient(#d6e4eb 0, #f2fbff 31%, #bfd3e9 100%);
    --metal-ink: #1e416e;
    --font: 'Saira Semi Condensed', 'Arial Narrow', system-ui, sans-serif;
    --notch: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    --wrap: 1180px;
  }
  * {
    box-sizing: border-box;
  }
  [hidden] {
    display: none !important;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.5 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }

  /* Top bar */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: linear-gradient(#272929, #1c1d1d);
    border-bottom: 1px solid #0c0d0d;
    box-shadow: 0 3px 6px var(--bg);
  }
  .bar-inner {
    max-width: var(--wrap);
    height: 46px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
  }
  .brand {
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bright);
    text-shadow: 0 1px 0 #000;
  }
  .suggest {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px 4px 9px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    color: var(--metal-ink);
    background: var(--metal);
    clip-path: var(--notch);
    white-space: nowrap;
  }
  .suggest:hover {
    filter: brightness(1.06);
  }
  .suggest:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .suggest svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
  }

  main {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 36px 16px 64px;
  }

  /* Hero + filters */
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 32px;
    margin-bottom: 24px;
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 6px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .sq {
    width: 8px;
    height: 8px;
    background: var(--teal);
  }
  h1 {
    margin: 0 0 8px;
    font-size: clamp(34px, 7vw, 48px);
    font-weight: 400;
    line-height: 1.05;
    color: var(--bright);
  }
  .sub {
    margin: 0;
    color: var(--muted);
    max-width: 58ch;
  }
  /* "I play" picker: one choice, the chosen one gets the metal button look */
  .picker {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .picker legend {
    padding: 0;
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .seg {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 3px;
    padding: 3px;
    background: #0d0e0e;
    border: 1px solid var(--line-hi);
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
  }
  .opt {
    --c: var(--text);
    position: relative;
    cursor: pointer;
  }
  .opt input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .opt > span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 7px 16px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.03em;
    white-space: nowrap;
    color: var(--text);
    transition: background-color 0.15s, color 0.15s;
  }
  .opt .dot {
    width: 8px;
    height: 8px;
    background: var(--c);
  }
  .opt.all .dot {
    background: linear-gradient(135deg, #e3a857 0 33%, #b99cff 33% 66%, #6fd5b4 66%);
  }
  .opt .n {
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }
  .opt:hover > span {
    background: #1d2020;
    color: var(--bright);
  }
  .opt input:checked + span {
    background: var(--metal);
    color: var(--metal-ink);
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  }
  .opt input:checked + span .n {
    color: var(--metal-ink);
    opacity: 0.7;
  }
  .opt input:checked + span .dot {
    outline: 1px solid rgba(30, 65, 110, 0.5);
  }
  .opt input:focus-visible + span {
    outline: 2px solid var(--teal);
    outline-offset: -2px;
  }
  .opt.pvp,
  .mode.pvp {
    --c: #e3a857;
  }
  .opt.pvps,
  .mode.pvps {
    --c: #b99cff;
  }
  .opt.pve,
  .mode.pve {
    --c: #6fd5b4;
  }

  /* How to redeem */
  .steps {
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
