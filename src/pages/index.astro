---
import '@fontsource/saira-semi-condensed/latin-400.css';
import '@fontsource/saira-semi-condensed/latin-700.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import CodeCard from '../components/CodeCard.astro';
import { codes, modes, updated } from '../codes';
import { getContributors } from '../contributors';
import fr from '../i18n/fr.json';
import en from '../i18n/en.json';
import type { Mode } from '../codes';

const modeLabel = en.modes as Record<Mode, string>;

const updatedLabel = new Date(updated + 'T00:00:00Z').toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const repo = 'https://github.com/Wilsman/tarkovcodes';
const discord = 'https://discord.gg/3dFmr5qaJK';
const siteUrl = new URL('/', Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const description = en.meta.description;

// Newest first; codes without a date go last.
const sorted = [...codes].sort((a, b) => (b.added ?? '').localeCompare(a.added ?? ''));
const working = sorted.filter((c) => c.status === 'working');
const expired = sorted.filter((c) => c.status === 'expired');
// Picker counts are for working codes, since that's what the main grid shows.
const counts = Object.fromEntries(modes.map((m) => [m, working.filter((c) => c.modes.includes(m)).length]));

const contributors = await getContributors();
const contribTitle = (login: string, n: number) =>
  `${login} · ${n} ${n === 1 ? en.contribution : en.contributions}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#131414" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{en.meta.title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />

    <!-- Link preview: the in-game "Code activation" dialog with the site URL typed in -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={en.brand} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={en.meta.title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={en.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={en.meta.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header class="topbar">
      <div class="bar-inner">
        <a class="brand" href="/">{en.brand}</a>
        <div class="language-picker" role="group" aria-label="Langue / Language">
          <button type="button" class="locale" data-locale="fr" aria-label="Français" title="Français" aria-pressed="false">
            <img src="/flags/fr.svg" alt="" width="24" height="16" />
          </button>
          <button type="button" class="locale active" data-locale="en" aria-label="English" title="English" aria-pressed="true">
            <img src="/flags/en.svg" alt="" width="24" height="16" />
          </button>
        </div>
        <a class="suggest" href={`${repo}/issues/new/choose`} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          <span class="suggest-label">{en.suggestCode}</span>
        </a>
      </div>
    </header>

    <main>
      <div class="hero">
        <div>
          <p class="kicker" data-updated-date={updated}><span class="sq"></span><span class="kicker-date">{en.updated} {updatedLabel}</span></p>
          <h1>{en.heading}</h1>
        </div>
        <fieldset class="picker" hidden>
          <div class="seg">
            <label class="opt all" title={en.showAllTitle}>
              <input type="radio" name="mode" value="all" checked />
              <span><span class="dot" aria-hidden="true"></span><span class="opt-label">{en.all}</span> <span class="n">{working.length}</span></span>
            </label>
            {
              modes.map((m) => (
                <label class={`opt ${m}`} data-mode-picker={m} title={`${en.pickerTitle} ${modeLabel[m]}`}>
                  <input type="radio" name="mode" value={m} />
                  <span>
                    <span class="dot" aria-hidden="true"></span>
                    <span class="opt-label">{modeLabel[m]}</span> <span class="n">{counts[m]}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
      </div>

      <ol class="steps" aria-label={en.redeemAria}>
        <li><span class="num">1</span><span class="txt" data-i="0">{en.redeem[0]}</span></li>
        <li><span class="num">2</span><span class="txt"><span data-i="1">{en.redeem[1]}</span> <span class="arr">&rarr;</span> <span data-i="2">{en.redeem[2]}</span> <span class="arr">&rarr;</span> <b data-i="3">{en.redeem[3]}</b></span></li>
        <li><span class="num">3</span><span class="txt" data-i="4">{en.redeem[4]}</span></li>
      </ol>

      <ul class="grid">
        {working.map((item, i) => <CodeCard item={item} eager={i < 3} />)}
      </ul>
      <p class="empty-msg" hidden>{en.empty}</p>

      {
        expired.length > 0 && (
          <details class="expired">
            <summary>
              <span class="exp-title">{en.expired}</span>
              <span class="exp-n">{expired.length}</span>
              <span class="exp-hint">
                <span class="show">{en.show}</span>
                <span class="hide">{en.hide}</span>
              </span>
            </summary>
            <p class="exp-sub">{en.expiredSubtitle}</p>
            <ul class="grid">
              {expired.map((item) => (
                <CodeCard item={item} />
              ))}
            </ul>
          </details>
        )
      }

      <footer>
        <div class="foot-top">
          {
            contributors.length > 0 && (
              <div class="contrib">
                <div class="avatars">
                  {contributors.map((c) => (
                    <a
                      href={c.url}
                      target="_blank"
                      rel="noopener"
                      title={contribTitle(c.login, c.contributions)}
                      aria-label={`${c.login} on GitHub`}
                      data-login={c.login}
                      data-contribs={c.contributions}
                    >
                      <img src={c.avatar} alt="" width="28" height="28" loading="lazy" decoding="async" />
                    </a>
                  ))}
                </div>
                <span class="contrib-label">
                  <b>{contributors.length}</b>{' '}
                  <span class="contrib-word">{contributors.length === 1 ? en.contributor : en.contributors}</span>
                </span>
              </div>
            )
          }
          <nav class="foot-links">
            <a class="discord-link" href={discord} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.028C.533 9.046-.319 13.58.099 18.058a.082.082 0 0 0 .031.056 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.873-1.295 1.226-1.994a.076.076 0 0 0-.042-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .078-.011c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .079.01c.12.099.246.198.373.292a.077.077 0 0 1-.007.128c-.598.349-1.22.645-1.873.891a.077.077 0 0 0-.041.107c.36.698.772 1.363 1.225 1.993a.076.076 0 0 0 .084.029 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.029zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.419s.955-2.419 2.157-2.419c1.21 0 2.176 1.095 2.157 2.42 0 1.332-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419s.955-2.419 2.157-2.419c1.21 0 2.176 1.095 2.157 2.42 0 1.332-.946 2.418-2.157 2.418z"/></svg>
              Discord
            </a>
            <a href={repo} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              GitHub
            </a>
          </nav>
        </div>
        <p class="foot-line">
          <span class="footer-new-code">{en.footerNewCode}</span>{' '}
          <a class="tell-us" href={`${repo}/issues/new/choose`} target="_blank" rel="noopener">{en.tellUs}</a>. <span class="site-is">{en.siteIs}</span>{' '}
          <a class="open-source" href={repo} target="_blank" rel="noopener">{en.openSource}</a>.
        </p>
        <p class="foot-line dim">{en.disclaimer}</p>
      </footer>
    </main>

    <dialog class="viewer" aria-label={en.viewerAria}></dialog>
    <div class="toast" role="status" aria-live="polite" data-copied-toast={en.copiedToast} data-copy-failed={en.copyFailed}></div>

    <script is:inline define:vars={{ locales: { fr, en } }}>
      (() => {
        const localeButtons = document.querySelectorAll('[data-locale]');
        const applyLocale = (locale) => {
          const t = Object.prototype.hasOwnProperty.call(locales, locale) ? locales[locale] : locales.en;
          document.documentElement.lang = locale;
          document.title = t.meta.title;
          document.querySelector('meta[name="description"]')?.setAttribute('content', t.meta.description);
          document.querySelector('meta[property="og:title"]')?.setAttribute('content', t.meta.title);
          document.querySelector('meta[property="og:description"]')?.setAttribute('content', t.meta.description);
          document.querySelector('meta[property="og:image:alt"]')?.setAttribute('content', t.meta.ogImageAlt);
          document.querySelector('meta[name="twitter:title"]')?.setAttribute('content', t.meta.title);
          document.querySelector('meta[name="twitter:description"]')?.setAttribute('content', t.meta.description);

          document.querySelector('.suggest-label').textContent = t.suggestCode;
          document.querySelector('.brand').textContent = t.brand;
          const kicker = document.querySelector('.kicker');
          const updatedDate = new Date(kicker.dataset.updatedDate + 'T00:00:00Z').toLocaleDateString(
            locale === 'fr' ? 'fr-FR' : 'en-GB',
            { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' },
          );
          kicker.querySelector('.kicker-date').textContent = t.updated + ' ' + updatedDate;
          document.querySelector('h1').textContent = t.heading;
          document.querySelector('.opt.all').title = t.showAllTitle;
          document.querySelector('.opt.all .opt-label').textContent = t.all;
          document.querySelectorAll('.opt[data-mode-picker]').forEach((el) => {
            const mode = el.dataset.modePicker;
            el.title = t.pickerTitle + ' ' + t.modes[mode];
            el.querySelector('.opt-label').textContent = t.modes[mode];
          });
          document.querySelector('.steps').setAttribute('aria-label', t.redeemAria);
          document.querySelectorAll('.steps [data-i]').forEach((el) => {
            el.textContent = t.redeem[el.dataset.i];
          });
          document.querySelector('.empty-msg').textContent = t.empty;
          document.querySelector('.exp-title')?.replaceChildren(t.expired);
          document.querySelector('.exp-sub')?.replaceChildren(t.expiredSubtitle);
          document.querySelector('.show')?.replaceChildren(t.show);
          document.querySelector('.hide')?.replaceChildren(t.hide);
          document.querySelector('.footer-new-code').textContent = t.footerNewCode;
          document.querySelector('.tell-us').textContent = t.tellUs;
          document.querySelector('.open-source').textContent = t.openSource;
          document.querySelector('.site-is').textContent = t.siteIs;
          document.querySelector('.foot-line.dim').textContent = t.disclaimer;
          const avatarLinks = document.querySelectorAll('.avatars a');
          document
            .querySelector('.contrib-word')
            ?.replaceChildren(avatarLinks.length === 1 ? t.contributor : t.contributors);
          avatarLinks.forEach((el) => {
            const n = Number(el.dataset.contribs);
            el.title = el.dataset.login + ' · ' + n + ' ' + (n === 1 ? t.contribution : t.contributions);
          });
          document.querySelector('.viewer').setAttribute('aria-label', t.viewerAria);

          document.querySelectorAll('.mode.all').forEach((el) => {
            el.title = t.allModesTitle;
            el.textContent = t.allModes;
          });
          document.querySelectorAll('.mode[data-mode]').forEach((el) => {
            const mode = el.dataset.mode;
            if (mode === 'all') return;
            const only = el.querySelector('.only');
            el.title = only ? t.modeTitles[mode] + ' ' + t.only : t.modeTitles[mode];
            if (only) only.textContent = t.only;
          });
          document.querySelectorAll('[data-status]').forEach((el) => {
            el.textContent = el.dataset.status === 'working' ? t.working : t.expiredStatus;
          });
          document.querySelectorAll('.copy-label').forEach((el) => {
            el.textContent = el.closest('.code')?.classList.contains('copied') ? t.copied : t.copy;
          });
          document.querySelectorAll('.code').forEach((el) => {
            el.dataset.copyLabel = t.copy;
            el.dataset.copiedLabel = t.copied;
            el.setAttribute('aria-label', t.copyAria + ' ' + el.dataset.code);
          });
          document.querySelectorAll('.shot').forEach((el) => {
            el.setAttribute('aria-label', t.enlargeRewards + ' ' + el.closest('li').querySelector('[data-code]').dataset.code);
            const img = el.querySelector('img');
            if (img) img.alt = t.rewards + ' ' + el.closest('li').querySelector('[data-code]').dataset.code;
          });
          document.querySelectorAll('.shot.empty').forEach((el) => {
            el.textContent = el.closest('li').classList.contains('dead') ? t.noScreenshot : t.noScreenshotYet;
          });
          document.querySelectorAll('[data-note-key]').forEach((el) => {
            // Fall back to English if a note hasn't been translated yet.
            el.textContent = t.codeNotes[el.dataset.noteKey] ?? locales.en.codeNotes[el.dataset.noteKey] ?? el.textContent;
          });
          document.querySelectorAll('time[data-added]').forEach((el) => {
            el.textContent = t.added + ' ' + new Date(el.dataset.added + 'T00:00:00Z').toLocaleDateString(
              locale === 'fr' ? 'fr-FR' : 'en-GB',
              { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' },
            );
          });

          const toast = document.querySelector('.toast');
          toast.dataset.copiedToast = t.copiedToast;
          toast.dataset.copyFailed = t.copyFailed;
          localeButtons.forEach((button) => {
            const active = button.dataset.locale === locale;
            button.classList.toggle('active', active);
            button.setAttribute('aria-pressed', String(active));
          });
          try { localStorage.setItem('tc-language', locale); } catch {}
        };

        let initialLocale = 'en';
        try {
          const savedLocale = localStorage.getItem('tc-language');
          initialLocale = savedLocale && Object.prototype.hasOwnProperty.call(locales, savedLocale)
            ? savedLocale
            : 'en';
        } catch {}
        localeButtons.forEach((button) => button.addEventListener('click', () => applyLocale(button.dataset.locale)));
        applyLocale(initialLocale);

        // Copy to clipboard
        const toast = document.querySelector('.toast');
        let t;
        const copy = async (text) => {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.cssText = 'position:fixed;opacity:0';
            document.body.appendChild(ta);
            ta.select();
            const ok = document.execCommand('copy');
            ta.remove();
            return ok;
          }
        };

        // Click-to-enlarge screenshots
        // A fresh <img> per open, so the previous screenshot never shows. It starts
        // with the card's already-loaded copy and swaps to full size once decoded.
        const viewer = document.querySelector('.viewer');
        viewer.addEventListener('click', () => viewer.close());
        viewer.addEventListener('close', () => viewer.replaceChildren());

        document.addEventListener('click', async (e) => {
          const shot = e.target.closest('[data-full]');
          if (shot) {
            const thumb = shot.querySelector('img');
            const img = new Image();
            img.alt = thumb?.alt || '';
            const w = Number(shot.dataset.w);
            const h = Number(shot.dataset.h);
            img.width = w;
            img.height = h;
            // Final size up front, so the swap to full size doesn't resize it.
            img.style.width = `min(${w}px, 96vw - 2px, 1098px, (92vh - 2px) * ${w / h})`;
            img.src = thumb?.currentSrc || shot.dataset.full;
            viewer.replaceChildren(img);
            viewer.showModal();
            const full = new Image();
            full.src = shot.dataset.full;
            full
              .decode()
              .then(() => {
                if (img.isConnected) img.src = full.src;
              })
              .catch(() => {});
            return;
          }
          const btn = e.target.closest('[data-code]');
          if (!btn) return;
          const code = btn.dataset.code;
          const ok = await copy(code);
          btn.classList.toggle('copied', ok);
          btn.querySelector('.copy-label').textContent = ok ? btn.dataset.copiedLabel : btn.dataset.copyLabel;
          clearTimeout(btn._t);
          btn._t = setTimeout(() => {
            btn.classList.remove('copied');
            btn.querySelector('.copy-label').textContent = btn.dataset.copyLabel;
          }, 1600);
          toast.textContent = ok ? code + ' ' + toast.dataset.copiedToast : toast.dataset.copyFailed;
          toast.classList.add('show');
          clearTimeout(t);
          t = setTimeout(() => toast.classList.remove('show'), 1600);
        });

        // "I play" picker: show the codes that work in the chosen mode
        const KEY = 'tc-mode';
        const picker = document.querySelector('.picker');
        const cards = [...document.querySelectorAll('.grid > li')];
        const emptyMsg = document.querySelector('.empty-msg');
        const expiredN = document.querySelector('.exp-n');
        const apply = (mode) => {
          let live = 0;
          let dead = 0;
          for (const card of cards) {
            const show = mode === 'all' || card.dataset.modes.split(' ').includes(mode);
            card.hidden = !show;
            if (show) card.classList.contains('dead') ? dead++ : live++;
          }
          emptyMsg.hidden = live > 0;
          if (expiredN) expiredN.textContent = String(dead);
        };
        let saved = 'all';
        try {
          saved = localStorage.getItem(KEY) || 'all';
          localStorage.removeItem('tc-modes'); // old toggle setting
        } catch {}
        const input = picker.querySelector(`input[value="${CSS.escape(saved)}"]`) || picker.querySelector('input');
        input.checked = true;
        picker.addEventListener('change', (e) => {
          apply(e.target.value);
          try {
            localStorage.setItem(KEY, e.target.value);
          } catch {}
        });
        picker.hidden = false;
        apply(input.value);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #131414;
    --panel: #1b1c1c;
    --panel-2: #171818;
    --line: #2b2e2e;
    --line-hi: #3a3e3e;
    --text: #c2cdcd;
    --bright: #e7eded;
    --muted: #7f8989;
    --teal: #6fd5b4;
    --stash: #3d5559;
    --ok: #93cf86;
    --ok-bg: rgba(147, 207, 134, 0.1);
    --bad: #e2685a;
    --bad-bg: rgba(226, 104, 90, 0.1);
    --metal: linear-gradient(#d6e4eb 0, #f2fbff 31%, #bfd3e9 100%);
    --metal-ink: #1e416e;
    --font: 'Saira Semi Condensed', 'Arial Narrow', system-ui, sans-serif;
    --notch: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    --wrap: 1180px;
  }
  * {
    box-sizing: border-box;
  }
  [hidden] {
    display: none !important;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.5 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }

  /* Top bar */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: linear-gradient(#272929, #1c1d1d);
    border-bottom: 1px solid #0c0d0d;
    box-shadow: 0 3px 6px var(--bg);
  }
  .bar-inner {
    max-width: var(--wrap);
    height: 46px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
  }
  .brand {
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bright);
    text-shadow: 0 1px 0 #000;
    white-space: nowrap;
  }
  .suggest {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px 4px 9px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    color: var(--metal-ink);
    background: var(--metal);
    clip-path: var(--notch);
    white-space: nowrap;
  }
  .suggest:hover {
    filter: brightness(1.06);
  }
  .suggest:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .suggest svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
  }

  main {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 26px 16px 64px;
  }

  /* Hero + filters */
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px 32px;
    margin-bottom: 18px;
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 8px;
